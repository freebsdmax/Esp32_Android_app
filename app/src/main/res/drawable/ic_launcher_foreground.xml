            <gradient
                android:type="linear"
                android:startX="43"
                android:startY="36"
                android:endX="74"
                android:endY="72">
                <item android:offset="0" android:color="#FF38BDF8" />
                <item android:offset="0.5" android:color="#FF6366F1" />
