        android:pathData="M47.8,36.6 C45.8,35.5 43.5,37.0 43.5,39.3 L43.5,68.7 C43.5,71.0 45.8,72.5 47.8,71.4 L73.4,56.4 C75.4,55.2 75.4,52.8 73.4,51.6 Z">
